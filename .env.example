# Copy to .env and fill in. Never commit .env.

# Gnani API key (Prisma speech-to-text + Timbre text-to-speech): https://app.gnani.ai/voice
# Without it the app still runs: use the sample questions or the Type tab (no voice in or out).
GNANI_API_KEY=
GNANI_STT_KEY=
GNANI_TTS_KEY=

# Optional: Evon v3.3 is open-weight (gnani/gnani-evon-v3.3-30B-A3B on Hugging Face).
# Serve it with an OpenAI-compatible server (for example vLLM) and set the URL, such as http://localhost:8000/v1
# Leave blank to use the built-in rule-based entity extraction.
EVON_BASE_URL=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_API_KEY=EMPTY

# Optional: free key from https://data.gov.in for live Agmarknet prices.
# Without it the app shows clearly labelled DEMO prices.
DATA_GOV_IN_API_KEY=

# Tunables
RAIN_THRESHOLD=70
TTS_MODEL=timbre-v2.5
TTS_VOICE=Nalini
ENABLE_TTS_TAGS=false
CACHE_TTL_SECONDS=600

# Optional offline speech recognition (pip install -r requirements-offline-voice.txt)
# tiny / base / small / medium
WHISPER_MODEL=small
